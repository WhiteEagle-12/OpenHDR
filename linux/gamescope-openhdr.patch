+uint openhdr_hash_u32(uvec2 p, uint seed) {
+    uint hash = p.x * 0x9e3779b9u + p.y * 0x85ebca6bu + seed;
+    hash ^= hash >> 16;
+    hash *= 0x7feb352du;
+    hash ^= hash >> 15;
+    hash *= 0x846ca68bu;
+    return hash ^ (hash >> 16);
+}
+
+float openhdr_hash21(uvec2 p, uint seed) {
+    return float(openhdr_hash_u32(p, seed) & 0x00ffffffu) / 16777216.0f;
+}
+
+float openhdr_ign(vec2 p) {
+    return fract(52.9829189f * fract(dot(p, vec2(0.06711056f, 0.00583715f))));
+}
+
+vec4 sampleOpenHDR(sampler2D tex, vec2 coord, vec2 texSize, uint colorspace, bool unnormalized) {
+    vec2 pixel = unnormalized ? coord : coord * texSize;
+    ivec2 maxPixel = ivec2(texSize) - ivec2(1);
+    ivec2 centerPixel = clamp(ivec2(floor(pixel)), ivec2(0), maxPixel);
+    vec4 centerSample = texelFetch(tex, centerPixel, 0);
+    vec3 center = clamp(centerSample.rgb, vec3(0.0f), vec3(1.0f));
+
+    vec3 filtered = center;
+    if (u_openhdrDebandStrength > 0.001f) {
+        uvec2 tile = uvec2(centerPixel) >> 3;
+        float pr1 = openhdr_hash21(tile, 0x243f6a88u);
+        vec2 rawDirection = vec2(
+            openhdr_hash21(tile, 0x13198a2eu),
+            openhdr_hash21(tile, 0xa4093822u)) * 2.0f - 1.0f;
+        rawDirection *= inversesqrt(max(dot(rawDirection, rawDirection), 0.0001f));
+        ivec2 direction = ivec2((pr1 * u_openhdrDebandRadius) * rawDirection);
+        vec3 average = 0.5f * (
+            texelFetch(tex, clamp(centerPixel + direction, ivec2(0), maxPixel), 0).rgb +
+            texelFetch(tex, clamp(centerPixel - direction, ivec2(0), maxPixel), 0).rgb);
+        vec3 smoothCandidate = mix(average, center, step(vec3(u_openhdrDebandThreshold), abs(center - average)));
+        filtered = clamp(mix(center, smoothCandidate, u_openhdrDebandStrength), vec3(0.0f), vec3(1.0f));
+    }
+    centerSample.rgb = colorspace_plane_degamma_tf(filtered, colorspace);
+    return centerSample;
+}
